#include <dt-bindings/advertising_mode.h>
#include <behaviors/advertising_mode.dtsi>
#include <behaviors/stp_indicators.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include "studio-macros.dtsi"

/* GLOBAL SETTINGS */

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    require-prior-idle-ms = <150>;
    quick-tap-ms = <175>;
};

/ {
    macros {
        vh_macro: vh_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp H>;
        };

        cl_macro: cl_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp L>;
        };

        m08: m08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N8>;
        };

        // WORK MACROS

        m_pt1: m_pt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp M &kp A &kp UNDER &kp P &kp T &kp N1>;
        };

        m_pt2: m_pt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp M &kp A &kp UNDER &kp P &kp T &kp N2>;
        };

        m_cma: m_cma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp M &kp A>;
        };

        m_ms: m_ms {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp S>;
        };

        m_aka: m_aka {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp K &kp A &kp SPACE>;
            label = "M_AKA";
        };

        m_psr: m_psr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp E &kp R &kp SPACE &kp S &kp T &kp M &kp N &kp T &kp SPACE &kp R &kp E &kp V>;
            label = "M_PSR";
        };

        // MENU MACRO (Alt+T, M, P)

        m_atmp: m_atmp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <20>;
            bindings = <&kp LALT &kp T &kp M &kp P>;
            label = "M_ATMP";
        };

        m14: m14 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1 &kp NUMBER_4>;
            label = "M14";
        };

        m17: m17 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1 &kp N7>;
            label = "M17";
        };

        mcn: mcn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp N>;
            label = "MCN";
        };
    };

    behaviors {
        td_z_n_y: td_z_n_y {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z_N_Y";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp Z>, <&kp N>, <&kp Y>;
        };

        td_v_h: td_v_h {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V_H";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp V>, <&vh_macro>;
        };

        td_c_l: td_c_l {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C_L";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&cl_macro>;
        };

        alt_bs: alt_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_BS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    #include "mwave_prim.dtsi"

    combos {
        compatible = "zmk,combos";

        oh8 {
            bindings = <&m08>;
            key-positions = <18 19>;
        };

        esc14 {
            bindings = <&m14>;
            key-positions = <18 20>;
        };

        esc17 {
            bindings = <&m17>;
            key-positions = <19 20>;
        };

        cl {
            bindings = <&cl_macro>;
            key-positions = <63 64>;
        };

        vh {
            bindings = <&vh_macro>;
            key-positions = <64 65>;
        };

        cn {
            bindings = <&mcn>;
            key-positions = <62 63>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp F1        &kp F2             &ht F10 F3        &kp F4       &kp F5         &kp F6       &kp F7     &kp F8     &kp F9    &kp F10    &kp F11    &kp F12    &kp HOME   &kp END  &kp INSERT  &to 1
&tog 2     &kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3      &kp N4       &kp N5         &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC
&kp TAB    &kp Q         &kp W              &kp E             &kp R        &kp T          &kp Y        &kp U      &kp I      &kp O     &kp P      &kp LBKT   &kp RBKT   &kp BSLH   &kp DEL
&mo 3      &mt LC(A) A   &mt LC(X) S        &mt LC(C) D       &mt LC(V) F  &mt KP_PLUS G  &kp H        &kp J      &kp K      &kp L     &kp SEMI   &kp SQT    &kp RET    &kp PG_UP
&kp LSHFT  &td_z_n_y     &kp X              &kp C             &kp V        &kp B          &kp N        &kp M      &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT  &kp UP     &kp PG_DN
&kp LCTRL  &kp LGUI      &alt_bs LALT BSPC  &ht RETURN SPACE  &kp SPACE    &kp RALT       &kp K_CMENU  &kp RCTRL  &kp LEFT   &kp DOWN  &kp RIGHT
            >;
        };

        // LAYER 1: FUNCTION / NUMPAD

        raise {
            display-name = "Fn";
            bindings = <
&kp ESCAPE      &kp C_MUTE   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_PP  &kp C_NEXT  &bl BL_CYCLE  &kp LG(D)  &kp LS(LG(S))  &kp LG(TAB)      &kp LG(S)        &none      &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp KP_NUMLOCK  &to 0
&kp GRAVE       &kp N1       &kp N2        &kp N3        &kp N4      &kp N5    &kp N6      &kp N7        &kp N8     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS        &kp EQUAL  &kp BACKSPACE
&kp TAB         &kp Q        &kp W         &kp E         &kp R       &kp T     &kp Y       &kp KP_N7     &kp KP_N8  &kp KP_N9      &kp KP_MINUS     &kp LBKT         &kp RBKT   &kp BSLH        &kp DELETE
&studio_unlock  &kp A        &kp S         &kp D         &kp F       &kp G     &kp H       &kp KP_N4     &kp KP_N5  &kp KP_N6      &kp KP_PLUS      &kp SQT          &kp ENTER  &kp PAGE_UP
&kp LEFT_SHIFT  &kp Z        &kp X         &kp C         &kp V       &kp B     &kp N       &kp KP_N1     &kp KP_N2  &kp KP_N3      &kp KP_ENTER     &kp RIGHT_SHIFT  &kp UP     &kp PAGE_DOWN
&kp LCTRL       &bootloader  &kp LALT      &kp SPACE     &kp KP_N0   &kp RALT  &kp KP_DOT  &kp RCTRL     &kp LEFT   &kp DOWN       &kp RIGHT
            >;
        };

        // LAYER 2: WORK MACROS (CMA)

        work_layer {
            display-name = "CMA";
            bindings = <
&trans    &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &m_pt1   &m_pt2  &m_cma  &m_ms   &m_aka  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&m_psr    &m_atmp  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp CLCK  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // LAYER 3: NAV LAYER (WASD + LEFT THUMB ENTER)

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &trans    &trans         &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans         &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &kp UP         &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT  &kp DOWN       &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans         &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &kp BACKSPACE  &kp ENTER  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra1 {
            display-name = "Blue";
            status = "reserved";
        };

        extra2 {
            display-name = "Green";
            status = "reserved";
        };

        extra3 {
            display-name = "Red";
            status = "reserved";
        };

        extra4 {
            display-name = "Purple";
            status = "reserved";
        };

        extra5 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra6 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
